# Every Config field has a KMITL_<FIELD> environment variable. Handy for
# containers and systemd, and it keeps the password off the command line.
KMITL_USERNAME=65010000

# In a container the environment IS the secret store: there is no config file
# to protect, and `docker compose` reads this file. Keep it mode 600 and out of
# version control. The password_enc schemes are for the desktop/service case.
KMITL_PASSWORD=your-password

# Optional overrides
#KMITL_IP_ADDRESS=
#KMITL_MAC_ADDRESS=
KMITL_HEARTBEAT_INTERVAL=300
KMITL_RELOGIN_INTERVAL=28800
KMITL_WATCHDOG_TIMEOUT=180
KMITL_LOG_LEVEL=INFO
KMITL_LOG_JSON=false
KMITL_CONTROL_HOST=0.0.0.0
KMITL_CONTROL_PORT=8777
#KMITL_CONTROL_TOKEN=pick-something-random
KMITL_STATE_DIR=/var/lib/kmitl-authen
